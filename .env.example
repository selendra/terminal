# Selendra Terminal - Environment Configuration
# Copy this file to .env.local and adjust as needed

# ==============================================
# RPC Endpoints Configuration
# ==============================================

# Option 1: Use local Selendra node (for docker-compose setup)
# NEXT_PUBLIC_SUBSTRATE_RPC_WS=ws://localhost:9944
# NEXT_PUBLIC_SUBSTRATE_RPC_HTTP=http://localhost:9933
# NEXT_PUBLIC_EVM_RPC_HTTP=http://localhost:9933

# Option 2: Use public Selendra RPC (default)
NEXT_PUBLIC_SUBSTRATE_RPC_WS=wss://rpc.selendra.org
NEXT_PUBLIC_SUBSTRATE_RPC_HTTP=https://rpc.selendra.org
NEXT_PUBLIC_EVM_RPC_HTTP=https://rpc.selendra.org

# Testnet endpoints (optional)
NEXT_PUBLIC_SUBSTRATE_RPC_WS_TESTNET=wss://rpc-testnet.selendra.org
NEXT_PUBLIC_SUBSTRATE_RPC_HTTP_TESTNET=https://rpc-testnet.selendra.org
NEXT_PUBLIC_EVM_RPC_HTTP_TESTNET=https://rpc-testnet.selendra.org
