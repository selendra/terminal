# Selendra Terminal - Environment Configuration
# Copy this file to .env.local and adjust as needed
#
# HYBRID ARCHITECTURE:
# The explorer automatically handles failover:
#   Primary: Local node (if configured) → Fallback: Public RPC (rpc.selendra.org)
#
# If you don't set any endpoints, it defaults to public RPC.
# If you set local endpoints, it will try those first, then fall back to public.

# ==============================================
# RPC Endpoints Configuration (Mainnet)
# ==============================================

# Option 1: Local Development with Docker node
# The explorer will try these first, then fall back to public RPC
# NEXT_PUBLIC_SUBSTRATE_RPC_WS=ws://localhost:9944
# NEXT_PUBLIC_SUBSTRATE_RPC_HTTP=http://localhost:9933
# NEXT_PUBLIC_EVM_RPC_HTTP=http://localhost:9933

# Option 2: Public RPC Only (default if nothing is set)
# Leave the above commented out to use public RPC directly
# The explorer will use wss://rpc.selendra.org automatically

# ==============================================
# SubQuery Indexer Configuration
# ==============================================

# GraphQL endpoint for indexed data (blocks, transactions, accounts)
# Local development: http://localhost:3001/graphql
# Production: https://indexer.selendra.org/graphql
NEXT_PUBLIC_INDEXER_GRAPHQL_URL=http://localhost:3001/graphql

# ==============================================
# RPC Endpoints Configuration (Testnet)
# ==============================================

# Testnet endpoints (optional - defaults to public testnet RPC)
# NEXT_PUBLIC_SUBSTRATE_RPC_WS_TESTNET=wss://rpc-testnet.selendra.org
# NEXT_PUBLIC_SUBSTRATE_RPC_HTTP_TESTNET=https://rpc-testnet.selendra.org
# NEXT_PUBLIC_EVM_RPC_HTTP_TESTNET=https://rpc-testnet.selendra.org

# ==============================================
# Error Tracking (Optional)
# ==============================================

# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
